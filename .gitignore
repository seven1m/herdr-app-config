# This repo is checked out as ~/.config/herdr-app itself, next to Herdr's own files and secrets
# (linear.json, shared.json, data/, frame/ …). Ignore everything, then allow only our files.
/*
!/.gitignore
!/RECIPE.md
!/settings.json
!/keys.json
!/layouts/
/layouts/*
!/layouts/my-main.json
!/mods/
/mods/*
!/mods/arch-diagrams/
!/mods/aws-sso/
!/mods/branch-changes/
!/mods/changes-minimap/
!/mods/gmail/
!/mods/linear/
!/mods/mac-calendar/
!/mods/my-prs/
!/mods/now-playing/
# Editor type stubs Herdr writes; never commit secrets even inside an allowed folder.
jsconfig.json
*.d.ts
linear.json
# arch-diagrams: what setup.sh installs and the render cache, with machine-specific paths.
/mods/arch-diagrams/.chrome/
/mods/arch-diagrams/.renders/
/mods/arch-diagrams/node_modules/
/mods/arch-diagrams/.node-path
/mods/arch-diagrams/.puppeteer.json
